# ── Docker ──────────────────────────────────────────────────────────────────
# Port on the host for the web app. APP_BIND=127.0.0.1 on a server behind a proxy.
APP_PORT=8011
APP_BIND=0.0.0.0
# Host port for MySQL (only on 127.0.0.1, for DB tools).
DB_FORWARD_PORT=33071
# "ollama" starts the bundled Ollama container. Leave empty if you use a shared one.
COMPOSE_PROFILES=ollama
# Shared Ollama instead (uncomment both, and set COMPOSE_PROFILES= above):
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-ollama.yml
# AI_NETWORK=my_shared_network

# ── Database (MySQL 8) ──────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_DATABASE=resume_screener
DB_USERNAME=screener
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ── AI (Ollama) ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Seconds per AI call before it counts as failed.
OLLAMA_TIMEOUT_SECONDS=300
# Download missing models on start-up (a few GB, first start only).
OLLAMA_PULL_MODELS=true
# How many requests the bundled Ollama serves at once.
OLLAMA_NUM_PARALLEL=4

# ── Pipeline ────────────────────────────────────────────────────────────────
PIPELINE_WORKERS=3
PIPELINE_MAX_WORKERS=8
PIPELINE_QUEUE_SIZE=64
PIPELINE_MAX_ATTEMPTS=3

# ── Demo data and limits ────────────────────────────────────────────────────
# Create 3 made-up jobs and 40 made-up resumes on an empty database.
SEED_DEMO_DATA=true
# Screen the seeded resumes straight away.
SEED_AUTO_SCREEN=true
UPLOAD_MAX_FILES=50
UPLOAD_MAX_FILE_KB=2048
